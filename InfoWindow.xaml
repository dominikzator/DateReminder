<Window x:Class="DateReminder.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DateReminder"
        mc:Ignorable="d"
        Title="InfoWindow" Height="168" Width="350" Background="#FFF9B84F" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid>
        <Button x:Name="OkButton" Content="Ok" Margin="109,86,110,21" Click="OkButton_Click"/>
        <Label x:Name="MessageLabel" Content="This is information message" FontFamily="MV Boli" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" Height="32" VerticalContentAlignment="Center" Margin="0,44,0,0"/>

    </Grid>
</Window>
