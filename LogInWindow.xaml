<Window x:Class="DateReminder.LogInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DateReminder"
        mc:Ignorable="d"
        Title="LogInWindow" Height="450" Width="800" Background="#FFF9B84F" ResizeMode="NoResize">
    <Grid>
        <Label Content="Login:" FontFamily="MV Boli" Margin="0,-22,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="146" FontSize="50"/>
        <Label Content="Password:" FontFamily="MV Boli" HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="146" FontSize="50" Margin="0,108,0,0"/>
        <TextBox x:Name="LoginTextBox" TextWrapping="Wrap" FontFamily="MV Boli" Margin="276,90,276,0" FontSize="20" VerticalAlignment="Top" VerticalContentAlignment="Center"/>
        <TextBox x:Name="PasswordTextBox" TextWrapping="Wrap" FontFamily="MV Boli" Margin="280,211,272,0" FontSize="20" VerticalAlignment="Top" VerticalContentAlignment="Center" KeyDown="PasswordTextBox_KeyDown"/>
        <Button x:Name="SignInButton" Content="Sign In" Margin="303,259,306,0" FontSize="18" FontFamily="MV Boli" VerticalAlignment="Top" Padding="0,0,0,0" VerticalContentAlignment="Top" Background="#FFEC8C00" Click="SignInButton_Click"/>
        <Label Content="Don't have an account?" FontFamily="MV Boli" HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="46" FontSize="14" Margin="0,322,0,0"/>
        <Label x:Name="IncorrectLoginLabel" Content="Incorrect Login or Password, Please try again" FontFamily="MV Boli" HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="46" FontSize="14" Margin="0,285,0,0" Background="#00000000" Foreground="#FFBD0000"/>
        <Button x:Name="RegisterButton" Content="Register" Margin="303,359,306,0" FontSize="18" FontFamily="MV Boli" VerticalAlignment="Top" Padding="0,0,0,0" VerticalContentAlignment="Top" Background="#FFEC8C00" Click="RegisterButton_Click"/>

    </Grid>
</Window>
