<Window x:Class="DateReminder.LogInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DateReminder"
        mc:Ignorable="d"
        Title="LogInWindow" Height="500" Width="800" Background="#FFF9B84F" ResizeMode="NoResize">
    <Grid>
        <Label Content="Login:" FontFamily="MV Boli" Margin="0,9,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="79" FontSize="50"/>
        <Label Content="Password:" FontFamily="MV Boli" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="70" FontSize="50" Margin="60,138,60,0" Grid.RowSpan="1"/>
        <TextBox x:Name="LoginTextBox" TextWrapping="Wrap" FontFamily="MV Boli" Margin="276,90,276,0" FontSize="20" VerticalAlignment="Top" VerticalContentAlignment="Center"/>
        <TextBox x:Name="PasswordTextBox" TextWrapping="Wrap" FontFamily="MV Boli" Margin="280,211,272,0" FontSize="20" VerticalAlignment="Top" VerticalContentAlignment="Center" KeyDown="PasswordTextBox_KeyDown"/>
        <Button x:Name="SignInButton" Content="Sign In" Margin="303,314,306,0" FontSize="18" FontFamily="MV Boli" VerticalAlignment="Top" Padding="0,0,0,0" VerticalContentAlignment="Top" Background="#FFEC8C00" Click="SignInButton_Click"/>
        <Label Content="Don't have an account?" FontFamily="MV Boli" HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="46" FontSize="14" Margin="0,378,0,0"/>
        <Label x:Name="IncorrectLoginLabel" Content="Incorrect Login or Password, Please try again" FontFamily="MV Boli" HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="46" FontSize="14" Margin="0,340,0,0" Background="#00000000" Foreground="#FFBD0000"/>
        <Button x:Name="RegisterButton" Content="Register" Margin="303,414,306,0" FontSize="18" FontFamily="MV Boli" VerticalAlignment="Top" Padding="0,0,0,0" VerticalContentAlignment="Top" Background="#FFEC8C00" Click="RegisterButton_Click"/>
        <CheckBox x:Name="RememberMeCheckBox" HorizontalAlignment="Center" VerticalAlignment="Top" Width="116" Height="40" VerticalContentAlignment="Center" Padding="0,0,0,0" HorizontalContentAlignment="Center" FontFamily="MV Boli" Margin="0,258,0,0" MinWidth="40" MinHeight="40" FlowDirection="RightToLeft" Content="Remember me" BorderThickness="0,0,0,0" RenderTransformOrigin="0.5,0.5" >
            <CheckBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="2" ScaleY="2"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </CheckBox.RenderTransform>
        </CheckBox>
    </Grid>
</Window>
