<Window x:Class="DateReminder.LogInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DateReminder"
        mc:Ignorable="d"
        Title="LogInWindow" Height="450" Width="800" Background="#FFF9B84F" ResizeMode="NoResize">
    <Grid>
        <Label Content="Login:" FontFamily="MV Boli" Margin="0,14,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="146" FontSize="50"/>
        <Label Content="Password:" FontFamily="MV Boli" HorizontalAlignment="Center" VerticalAlignment="Center" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="146" FontSize="50"/>
        <TextBox x:Name="LoginTextBox" TextWrapping="Wrap" FontFamily="MV Boli" Margin="276,126,276,0" FontSize="20" VerticalAlignment="Top" VerticalContentAlignment="Center"/>
        <TextBox x:Name="PasswordTextBox" TextWrapping="Wrap" FontFamily="MV Boli" Margin="280,247,272,0" FontSize="20" VerticalAlignment="Top" VerticalContentAlignment="Center"/>
        <Button x:Name="SignInButton" Content="Sign In" Margin="303,308,306,77" FontSize="18" FontFamily="MV Boli" VerticalAlignment="Center" Padding="0,0,0,0" VerticalContentAlignment="Top" Background="#FFEC8C00" Click="SignInButton_Click"/>

    </Grid>
</Window>
