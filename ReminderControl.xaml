<UserControl x:Class="DateReminder.ReminderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DateReminder"
             mc:Ignorable="d" MaxHeight="500" MaxWidth="2000">
    <Grid Background="LightGray">
        <StackPanel Margin="5">
            <TextBlock x:Name="TitleText" Text="Urodziny Sylwii" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="TargetDateText" Text="Data: 21.08.2024" FontSize="15" Foreground="DodgerBlue"/>
            <TextBlock x:Name="IsCyclicText" Text="Priorytet: " FontSize="15" FontStyle="Italic"/>
        </StackPanel>
        <Image Height="40" Width="40" Source="/icons8-error-48.png" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" IsHitTestVisible="False" Panel.ZIndex="1"/>
        <Button x:Name="DeleteButton" Content="" Height="40" HorizontalContentAlignment="Center" Padding="1,1,0,1" HorizontalAlignment="Right" Margin="0,0,5,0" BorderThickness="1,1,1,1" Width="40" Click="DeleteButton_Click"/>

        <Image Height="40" Width="40" Source="/modify_icon.png" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,50,0" IsHitTestVisible="False" Panel.ZIndex="1"/>
        <Button x:Name="ModifyButton" Content="" Height="40" HorizontalContentAlignment="Center" Padding="1,1,0,1" HorizontalAlignment="Right" Margin="0,0,50,0" BorderThickness="1,1,1,1" Width="40" Click="ModifyButton_Click"/>

    </Grid>
</UserControl>
