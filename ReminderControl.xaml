<UserControl x:Class="DateReminder.ReminderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DateReminder"
             mc:Ignorable="d" MaxHeight="500" MaxWidth="2000">
    <Grid Background="LightGray">
        <StackPanel Margin="5">
            <TextBlock x:Name="TitleText" Text="Urodziny Sylwii" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="TargetDateText" Text="Data: 21.08.2024" FontSize="15" Foreground="DodgerBlue"/>
            <TextBlock x:Name="PriorityText" Text="Priorytet: " FontSize="15" FontStyle="Italic"/>
        </StackPanel>
    </Grid>
</UserControl>
