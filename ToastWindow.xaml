<Window x:Name="ToastWindow1" x:Class="DateReminder.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DateReminder"
        mc:Ignorable="d"
        Title="ToastWindow" Height="60
        " Width="249" Loaded="OnToastWindowLoaded" ResizeMode="NoResize" UseLayoutRounding="False" WindowStyle="None" Topmost="True">

    <Grid Width="300">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="73*"/>
            <ColumnDefinition Width="27*"/>
        </Grid.ColumnDefinitions>
        <Rectangle x:Name="ToastBorder" HorizontalAlignment="Left" Height="142" VerticalAlignment="Center" Width="13" Fill="#FFF9B84F" Stroke="#FF737373" />
        <Image x:Name="ToastIcon" HorizontalAlignment="Left" Height="24" Margin="17,0,0,0" VerticalAlignment="Center" Width="25" Source="/RingBell.png" Stretch="UniformToFill"/>
        <Label x:Name="ToastTitle" Content="You have 123456789|123456789|" HorizontalAlignment="Left" Margin="44,4,0,0" VerticalAlignment="Top" Width="255" FontWeight="Bold" FontFamily="MV Boli" FontSize="11" Grid.ColumnSpan="2"/>
        <Label x:Name="ToastDescription" Content="In 3 Days" HorizontalAlignment="Left" Margin="44,29,0,0" VerticalAlignment="Top" Width="255" FontSize="10" FontFamily="MV Boli" Grid.ColumnSpan="2"/>

    </Grid>
</Window>
