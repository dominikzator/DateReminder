<Window x:Name="ToastWindow1" x:Class="DateReminder.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DateReminder"
        mc:Ignorable="d"
        Title="ToastWindow" Height="60
        " Width="300" Loaded="OnToastWindowLoaded" ResizeMode="NoResize" UseLayoutRounding="False" WindowStyle="None" Topmost="True">

    <Grid Width="300">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
        </Grid.ColumnDefinitions>
        <Rectangle x:Name="ToastBorder" HorizontalAlignment="Left" Height="142" VerticalAlignment="Center" Width="13" Fill="#FFFFC107" Stroke="#FF737373" />
        <Image x:Name="ToastIcon" HorizontalAlignment="Left" Height="24" Margin="18,0,0,0" VerticalAlignment="Center" Width="25" Source="/icons8-warning-48.png" Stretch="UniformToFill" Grid.ColumnSpan="4"/>
        <Label x:Name="ToastTitle" Content="Typesaasdasddddddddd" HorizontalAlignment="Left" Margin="52,4,0,0" VerticalAlignment="Top" Width="238" FontWeight="Bold" FontFamily="MV Boli"/>
        <Label x:Name="ToastDescription" Content="Toast Message" HorizontalAlignment="Left" Margin="52,30,0,0" VerticalAlignment="Top" Width="237" FontSize="10" Grid.ColumnSpan="4" FontFamily="MV Boli"/>
        <Viewbox Grid.ColumnSpan="4"/>

    </Grid>
</Window>
