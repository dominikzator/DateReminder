<Window x:Class="DateReminder.UpdateReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DateReminder"
        mc:Ignorable="d"
        Title="UpdateReminderWindow" Height="430" Width="800" Background="#FFF9B84F" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid>
        <Label Content="Reminder Title:" FontFamily="MV Boli" Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40" FontSize="20"/>
        <TextBox x:Name="TitleTextBox" TextWrapping="Wrap" FontFamily="MV Boli" Margin="0,43,0,0" FontSize="20" VerticalAlignment="Top" VerticalContentAlignment="Center" TextChanged="TitleTextBox_TextChanged" AllowDrop="False" HorizontalAlignment="Center" MinWidth="245" MaxWidth="500" Width="248" Grid.Row="1" Height="35" MaxHeight="35" KeyDown="TextBox_KeyDown"/>
        <Label Content="Target Date (Format: YYYY-MM-DD):" FontFamily="MV Boli" Margin="0,80,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="38" FontSize="20"/>
        <TextBox x:Name="TargetDateTextBox" TextWrapping="Wrap" FontFamily="MV Boli" Margin="276,121,276,0" FontSize="20" VerticalAlignment="Top" VerticalContentAlignment="Center" TextChanged="TargetDateTextBox_TextChanged" KeyDown="TextBox_KeyDown"/>

        <TextBox x:Name="DaysToNotifyTextBox" TextWrapping="Wrap" FontFamily="MV Boli" Margin="276,194,276,0" FontSize="20" VerticalAlignment="Top" VerticalContentAlignment="Center" TextChanged="DaysToNotifyTextBox_TextChanged" KeyDown="TextBox_KeyDown"/>
        <Label Content="Days To Notify:" FontFamily="MV Boli" Margin="0,156,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="39" FontSize="20"/>
        <CheckBox x:Name="IsCyclicCheckBox" HorizontalAlignment="Center" VerticalAlignment="Top" Width="116" Height="40" VerticalContentAlignment="Center" Padding="0,0,0,0" HorizontalContentAlignment="Center" FontFamily="MV Boli" Margin="0,238,0,0" MinWidth="40" MinHeight="40" FlowDirection="RightToLeft" Content="Is Cyclic" BorderThickness="0,0,0,0" RenderTransformOrigin="0.5,0.5" >
            <CheckBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="2" ScaleY="2"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </CheckBox.RenderTransform>
        </CheckBox>

        <Label x:Name="IncorrectDataLabel" Content="Incorrect Login or Password, Please try again" FontFamily="MV Boli" HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="32" FontSize="14" Margin="0,269,0,0" Background="#00000000" Foreground="#FFBD0000"/>
        <Button x:Name="UpdateReminderButton" Content="Update Reminder" Margin="303,311,306,0" FontSize="18" FontFamily="MV Boli" VerticalAlignment="Top" Padding="0,0,0,0" VerticalContentAlignment="Top" Background="#FFEC8C00" Click="UpdateReminderButton_Click"/>

    </Grid>
</Window>
